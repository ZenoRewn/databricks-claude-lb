      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "lb-release-controller-nodes-lb-release-system"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "lb-release-controller",
          "namespace": "lb-release-system"
        }
      ],
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "lb-release-controller-nodes-lb-release-system"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "lb-release-controller",
        "namespace": "lb-release-system"
      },
      "spec": {
        "replicas": 2,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          }
        },
        "selector": {
          "matchLabels": {
            "app": "lb-release-controller"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "lb-release-controller"
            },
            "annotations": {
              "prometheus.io/scrape": "true",
              "prometheus.io/port": "9000",
              "prometheus.io/path": "/metrics"
            }
          },
          "spec": {
            "serviceAccountName": "lb-release-controller",
            "terminationGracePeriodSeconds": 20,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "affinity": {
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "app": "lb-release-controller"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            },
            "containers": [
              {
                "name": "controller",
                "image": "localhost:5008/controller@sha256:f74ea96d3060c0113ff8d9e0ee568c96daa1ef632bf8e4c214067d5a5737b533",
                "args": [
                  "--namespace",
                  "lb-release-system",
                  "--targets",
                  "lb-lab/claude-lb",
                  "--lab"
                ],
                "env": [
                  {
                    "name": "POD_UID",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.uid"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 9000
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "96Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 9000
                  },
                  "periodSeconds": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 9000
                  },
                  "periodSeconds": 10
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "lb-release-controller",
        "namespace": "lb-release-system"
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
