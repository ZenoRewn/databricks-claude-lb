# Databricks Claude Load Balancer 配置示例
# Author: Zeno Ren
# 复制此文件为 config.yaml 并填入真实值
#
# 2026-09-30 新增运行开关是环境变量，不是下面 YAML 的额外字段：
# LB_DIAGNOSTIC_QUEUE_CAPACITY=4096
# LB_STARTUP_BUDGET_OVERRIDES=[]               # 精确 provider/api_type/model 规则，默认不调预算
# LB_IMAGE_TRIM_POLICY=reject                 # allow 必须由管理员或调用方明确选择
# LB_CHAT_ADAPTER_CONTRACT=preserve           # 可回退为 text-only，拒绝无法保留的关键语义
# LB_CHAT_ADAPTER_PRESERVE_MODELS             # 未设置=全部已配置 adapter 模型；空=仅文本
# LB_CONTEXT_BUDGET_MODE=observe              # off/observe/enforce；估算永不作为输入硬拒绝依据
# LB_MODEL_CAPABILITIES_PATH                 # 可选本地 JSON；参见 model-capabilities.example.json
# 新监控契约显式请求 /metrics?schema=lb-metrics-v3，默认仍为 v2。
# 当前行为与采用步骤：docs/OBSERVABILITY_AND_CONTEXT.md
# GHCP 原生 Responses 流式 message ID 兼容开关（环境变量，启动时读取）：
# COPILOT_RESPONSES_ITEM_ID_MODE=off          # off/observe/stabilize；默认 off
# COPILOT_RESPONSES_ITEM_ID_MODELS=           # 逗号分隔的精确模型 allowlist；空=不启用任何模型
# COPILOT_STRIP_INPUT_ITEM_IDS=true          # stabilize 的必要前提；保留既有默认值
# 例如先在已授权测试环境 observe + 精确模型；协议与禁用方式见 docs/STREAM_PROTOCOL.md。

load_balancer:
  strategy: least_requests        # 负载均衡策略: least_requests, round_robin, random
  circuit_breaker_threshold: 5    # 连续错误次数达到此值后触发熔断
  circuit_breaker_timeout: 60     # 熔断恢复超时（秒）

# 上游凭据也可以由运维在 Dashboard / /admin/credentials 录入，不必写进本文件。
# 录入的凭据以 AES-256-GCM 封装后存入用量库，密钥取自环境变量 LB_CREDENTIAL_KEY
# （base64 32 字节，留在 K8s Secret 里、不入库）。未配该密钥时录入功能返回 503，
# 不会退化为存明文。录入后需一次滚动重启才生效 —— 端点在启动时统一构建。
# 详见 docs/CONFIGURATION.md 的「录入上游凭据」。

# Dashboard「密钥与渠道」页的解锁密码取自环境变量 LB_DASHBOARD_PASSWORD
# （≥12 字符，同样留在 Secret 里）。它换到一个 HttpOnly 会话 cookie，所以页面脚本
# 不持有任何凭据。未配置或过短时面板登录整体不可用（回落到用 LB API Key 解锁），
# 绝不退化为无密码放行。故意不进 LB_SETTINGS —— /config/effective 会把整个 settings
# 返回给任何持有效 key 的调用方。详见 docs/CONFIGURATION.md 的「解锁契约」。

auth:
  api_key: your-api-key-here      # 客户端认证密钥，Claude Code 需要使用此密钥
  # 多租户密钥（与上面的单 api_key 可共存）。租户名用作 metrics label、
  # 结构化日志字段，以及渠道限制的主键。
  # api_keys:
  #   default: ${LB_KEY_DEFAULT}
  #   team-a: ${LB_KEY_TEAM_A}
  #
  # 每个密钥可用的后端渠道（allowlist）**不在这里配置** —— 它存在用量存储里，
  # 通过 Dashboard「密钥与渠道」页或 PUT /admin/api-keys/{tenant}/providers 设置，
  # 立即生效并跨重启保留。未设置的租户默认允许全部渠道。
  # 渠道 id：databricks(ADB) / copilot(GHCP) / azure_openai(Foundry)。
  #
  # 轮换密钥：在本文件或 ${ENV} 源头替换后，调 POST /admin/api-keys/reload
  # 让网关重读，无需重启 Pod。网关不生成也不存储客户端密钥。注意 ${ENV}
  # 形式的值取自进程环境，改文件不会改变它们，仍需滚动重启。

endpoints:
  # Databricks Workspace 端点配置
  # 可以配置多个端点实现负载均衡

  - name: workspace-1
    api_base: https://adb-xxxxxxxxxxxx.xx.azuredatabricks.net/serving-endpoints
    token: ${DATABRICKS_TOKEN_1}  # 支持环境变量，或直接填写 token: dapixxxxxxxx
    weight: 1
    # 可选模型白名单，使用转换后的 Databricks 原生模型名。
    # 缺省/空列表保留旧的通配路由；列表是路由配置，不是上游能力验证证明。
    # models: [databricks-claude-opus-5, databricks-claude-sonnet-5]

  - name: workspace-2
    api_base: https://adb-yyyyyyyyyyyy.yy.azuredatabricks.net/serving-endpoints
    token: ${DATABRICKS_TOKEN_2}
    weight: 1

  # 可以继续添加更多端点...
  # - name: workspace-3
  #   api_base: https://adb-zzzzzzzzzzzz.zz.azuredatabricks.net/serving-endpoints
  #   token: ${DATABRICKS_TOKEN_3}
  #   weight: 1

# Token 用量数据持久化（可选）
# 方式 1: JSON 文件（默认）
# usage_data_dir: ./usage_data
#
# 方式 2: 高级配置（支持 JSON 或 MySQL）
# usage_storage:
#   type: json                        # json 或 mysql
#   path: ./usage_data                # type=json 时的存储目录
#   retention_days: 90                # 自动清理超过 N 天的数据（可选）
#
# usage_storage:
#   type: mysql                       # 使用 MySQL 8.x 存储（需安装 aiomysql）
#   host: localhost
#   port: 3306
#   user: root
#   password: ${MYSQL_PASSWORD}
#   database: claude_lb
#   pool_size: 5                      # 连接池大小（可选，默认 5）
#   retention_days: 90                # 自动清理（可选）

# Azure OpenAI 端点配置（可选）
# 配置后可通过 /v1/responses 和 /v1/chat/completions 路由访问
# azure_openai:
#   load_balancer:                    # 可选，不填则使用全局 load_balancer 配置
#     strategy: least_requests
#   endpoints:
#     - name: eastus-region
#       endpoint: https://my-openai-eastus.openai.azure.com  # 完整 Azure 端点 URL
#       api_key: ${AZURE_KEY_EASTUS}  # 支持环境变量
#       deployments:                  # 该资源上可用的部署列表
#         - gpt-4o
#         - gpt-5
#         - o4-mini
#       weight: 1
#     - name: westeurope-region
#       endpoint: https://my-openai-westeu.openai.azure.com
#       api_key: ${AZURE_KEY_WESTEU}
#       deployments:
#         - gpt-4o
#         - gpt-5
#       weight: 2

# GitHub Copilot 端点配置（可选）
# 与 Azure OpenAI 共享 /v1/chat/completions 与 /v1/responses 路由：
#   - claude-* 模型 → 默认只走 Databricks。例外是逐模型 opt-in：用
#     PUT /admin/model-routing/{model} 给某个 claude 模型配指向 copilot 的优先序，
#     该模型即在 OpenAI 风格入口放行。/v1/messages 仍然只走 Databricks。
#   - 其他模型 → Copilot 优先，模型不支持/全部熔断 → fallback 到 Azure OpenAI
#   - /v1/models 会列出 Azure deployments、显式 Copilot models；models: [] 通配时使用内置常用模型目录
#   - gpt-5.5/gpt-5.6-*/gpt-5-codex 等 Responses-only 模型如从 /v1/chat/completions 进入，会 buffered 转到 /v1/responses
#
# Token 三种来源（优先级递减）：
#   1) 下方 github_token 字段（支持 ${ENV_VAR}）
#   2) 本项目 device-flow 缓存 ~/.config/databricks-claude-lb/copilot-auth-<name>.json
#      生成方式: python main.py --copilot-login --endpoint <name>
#   3) 兼容 copilot-lb 旧缓存 ~/.config/copilot-lb/auth.json
#
# Short-lived Copilot session token 自动从 long-lived token 交换并内存缓存，过期前 60s 自动刷新。
#
# Microsoft Foundry 的 Anthropic 面（可选）—— Claude 的第三条路径。
# 与下面 azure_openai 是**同一个 Foundry 资源的两个面**：这里说 Anthropic Messages
# （`{api_base}/anthropic/v1/messages`），azure_openai 说 Azure OpenAI 形状。
# 两者分开成独立 provider，因为协议、鉴权头、模型 id 与计费单位都不同。
#
# azure_anthropic:
#   load_balancer:                  # 可选，不填则继承全局 load_balancer
#     circuit_breaker_threshold: 5
#     circuit_breaker_timeout: 60
#   endpoints:
#     - name: eastus2-foundry
#       api_base: ${CLAUDE_EASTUS2_FOUNDRY_MODEL_ENDPOINT}   # 资源根，不带路径
#       api_key: ${CLAUDE_EASTUS2_FOUNDRY_MODEL_KEY}
#       # deployments = 该资源上**实际存在**的 deployment 名，充当按模型选端点的门控。
#       # Foundry 没有 Models API（`GET /anthropic/v1/models` 实测 401），所以可用模型
#       # 只能这样由运维声明；写了不存在的名字会在请求时拿到 404 DeploymentNotFound。
#       deployments: [claude-opus-5-5, claude-opus-5, claude-sonnet-5-5, claude-haiku-5-5]
#       weight: 1
#       # auth_style 默认 x-api-key。**不要用 api-key** —— 官方文档列了它，但实测回 401。
#       # auth_style: x-api-key
#       # anthropic_version: "2023-06-01"
#
#   模型 id 注意：Foundry 用**短横**（claude-opus-5-5），GHCP 用**点号**
#   （claude-opus-5.5），ADB 带前缀（databricks-claude-opus-5-5）。跨路径回落时由
#   claude_model_identity 自动改写，但这里的 deployments 必须写 Foundry 的拼法。
#
#   计价：Foundry 按 Azure Marketplace 的 CCU 计量，既不是 Anthropic 公开 API 价也不是
#   GHCP 分档价。网关据此把它的费用报为**未知**而不是套用错表（见 CLAUDE.md 不变量）。

# github_copilot:
#   load_balancer:                    # 可选，不填则继承全局 load_balancer
#     strategy: least_requests
#     circuit_breaker_threshold: 5
#     circuit_breaker_timeout: 60
#   endpoints:
#     - name: gh-account-1
#       # github_token: ${GITHUB_COPILOT_TOKEN_1}  # 留空则自动从 device-flow 缓存读取
#       weight: 1
#       models: []                    # 空 = 接受所有模型；填了就只服务列表内模型
#       # api_types: [responses]       # 可选；不填兼容 responses+chat；显式空/无效列表启动失败
#       # enabled: false               # 可选，默认 true。false = 部署但不投入服务
#     # - name: gh-account-2
#     #   github_token: ${GITHUB_COPILOT_TOKEN_2}
#     #   weight: 1
#     #   models: [gpt-5, gpt-5.1, claude-opus-4.7]
#     # - name: gh-account-3           # 先落地、以后在 Dashboard 启用的写法
#     #   enabled: false
#
#   多账户要点：
#   - name 与 device-flow 缓存文件名对应（copilot-auth-<name>.json）。只写 name、
#     不写 github_token 时自动从缓存解析，凭据不进配置，且 token_source 为 file，
#     可被 /admin/copilot/reload 重读（写死明文的 literal 不行）。
#   - **不同 SKU 的账户模型集合会互缺**。实测 enterprise seat 有 gpt-5.4/5.5/5.6-luna
#     而 business seat 没有；business seat 有 gpt-6-astra/kimi-k3 而 enterprise 没有。
#     多账户时按 models: [] 通配会让请求有概率落到缺该模型的账户上失败，务必限定。
#   - 启用开关与「按账户勾选允许模型」在 Dashboard 的「密钥与渠道」页设置，存在
#     用量存储里，立即生效并跨重启保留；勾选只能在向上游发现的 capability 内。
#     未设置时按此处的 models 与 enabled 处理。详见 docs/CONFIGURATION.md。
#   - **enabled: false = 部署但不投入服务。** 端点照常加载、在 Dashboard 可见可操作，
#     但在被显式启用前不进任何候选集。token 来自只读 Secret 挂载、端点只在启动时
#     构建，所以不写进配置就没有可供 Dashboard 操作的对象 —— 这是账户唯一的
#     「先落地、确认后再启用」途径。启用一次后由存储接管，配置的声明不再回压。
#     存储不可用时保持此处声明的初始态（不 fail-open）：从没启用过的账户放行
#     不是「恢复既有行为」，而是把一个按设计不该接流量的账户推上线。
